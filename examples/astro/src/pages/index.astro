---
import BaseLayout from '../layouts/BaseLayout.astro';
import 'tag-sphere/styles';
import { controlLimits, demoDefaults, primaryTags } from '../../../shared/demo-data.js';
import { snippets } from '../../../shared/snippets.js';
import '../styles.css';

const astroDefaults = {
  ...demoDefaults,
  direction: (demoDefaults.direction + 180) % 360,
};
---

<BaseLayout title="tag-sphere • Astro Demo">
  <main class="page">
    <section class="panel">
      <div
        id="sphere"
        class="sphere"
        data-tags={JSON.stringify(primaryTags)}
        data-defaults={JSON.stringify(astroDefaults)}
        data-limits={JSON.stringify(controlLimits)}
      ></div>

      <div class="controls">
        <h2>Interactive Controls</h2>
        <label>Radius <input id="radius" type="range" min="60" max="200" step="5" value={astroDefaults.radius} /></label>
        <label>Speed <input id="speed" type="range" min="0.001" max="0.08" step="0.001" value={astroDefaults.speed} /></label>
        <label>Direction <input id="direction" type="range" min="0" max="359" step="1" value={astroDefaults.direction} /></label>
        <p class="values" id="values"></p>
        <p class="note">Astro page with the same runtime controls as Vanilla/React.</p>
      </div>
    </section>

    <section class="resource-grid">
      <article class="resource-card">
        <div class="snippet-head">
          <h2>Minimal Example</h2>
          <button id="copy-snippet" class="copy-btn" type="button" aria-live="polite" aria-label="Copy code">
            <span class="sr-only">Copy snippet</span>
          </button>
        </div>
        <pre class="code-block"><code id="snippet-code" set:html={snippets.astro.html}></code></pre>
      </article>
    </section>
  </main>

  <script>
    import { snippets } from '../../../shared/snippets.js';
    import { setupCopyButton } from '../../../shared/copy.js';
    import { setupSphereControls } from '../../../shared/sphere-controls.js';

    const sphereEl = document.getElementById('sphere');
    const radiusInput = document.getElementById('radius');
    const speedInput = document.getElementById('speed');
    const directionInput = document.getElementById('direction');
    const valuesEl = document.getElementById('values');
    const copyButton = document.getElementById('copy-snippet');

    if (
      !sphereEl ||
      !radiusInput ||
      !speedInput ||
      !directionInput ||
      !valuesEl ||
      !copyButton
    ) {
      throw new Error('Astro demo: missing DOM nodes.');
    }

    const tags = JSON.parse(sphereEl.dataset.tags || '[]');
    const defaults = JSON.parse(sphereEl.dataset.defaults || '{}');
    const limits = JSON.parse(sphereEl.dataset.limits || '{}');

    if (limits.radius) {
      radiusInput.min = String(limits.radius.min);
      radiusInput.max = String(limits.radius.max);
      radiusInput.step = String(limits.radius.step);
    }

    if (limits.speed) {
      speedInput.min = String(limits.speed.min);
      speedInput.max = String(limits.speed.max);
      speedInput.step = String(limits.speed.step);
    }

    if (limits.direction) {
      directionInput.min = String(limits.direction.min);
      directionInput.max = String(limits.direction.max);
      directionInput.step = String(limits.direction.step);
    }

    setupSphereControls({
      sphereEl,
      radiusInput,
      speedInput,
      directionInput,
      valuesEl,
      tags,
      defaults,
    });

    setupCopyButton(copyButton, () => snippets.astro.text, {
      defaultAria: 'Copy code',
      copiedAria: 'Copied',
      srText: 'Copy snippet',
    });
  </script>
</BaseLayout>
